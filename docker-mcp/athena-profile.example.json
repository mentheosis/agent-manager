{
  "name": "prod-audit",
  "description": "Read-only Athena audit queries",
  "cwd": "/absolute/host/path/agent_manager/docker-mcp",
  "argv": [
    "/absolute/host/path/athena-venv/bin/python",
    "/absolute/host/path/agent_manager/docker-mcp/athena_runner.py"
  ],
  "timeout_seconds": 330,
  "athena": {
    "aws_profile": "REPLACE_WITH_HOST_QUERY_PROFILE",
    "region": "eu-west-1",
    "catalog": "awsdatacatalog",
    "database": "athena_db",
    "workgroup": "staked-prod",
    "output_location": "s3://kn-bdp-dl-staked-prod/appdev/staging/",
    "allowed_tables": [
      "awsdatacatalog.athena_db.table1",
      "awsdatacatalog.athena_db.table2"
    ]
  }
}
