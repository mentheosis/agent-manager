{
  "permissions": {
    "allow": [
      "Bash(curl *)",
      "WebSearch",
      "WebFetch"
    ]
  ,
  "mcpServers": {
    "docker": {
      "type": "http",
      "url": "http://host.docker.internal:9090/",
      "headers": {
        "Authorization": "Bearer ${DOCKER_MCP_TOKEN}"
      }
    }
  }
}