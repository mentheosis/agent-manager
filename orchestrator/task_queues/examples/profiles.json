{
  "sample": {
    "database_env": "AM_SAMPLE_QUEUE_DATABASE",
    "repositories": {
      "sample": "/workspace/sample"
    },
    "default_max_workers": 2,
    "default_lease_secs": 60,
    "default_task_limit_secs": 3600,
    "default_task_limit_tokens": 2000000,
    "default_review_round_limit": 8,
    "tasks": {
      "report": {
        "instructions": "/workspace/sample/tasks/report.md",
        "provider": "codex",
        "model": "gpt-6-astra",
        "permission": "dangerFullAccess",
        "parameters": {
          "topic": {
            "type": "string",
            "required": true,
            "minLength": 1
          }
        },
        "inputs": [
          "README.md"
        ],
        "outputs": [
          "reports/{{topic}}.md"
        ]
      }
    },
    "use_isolated_workspace": true
  }
}
